# Get a key at aistudio.google.com (Get API key)
GEMINI_API_KEY=

PLANNER_MODEL=gemini-3.6-flash

# Docker Compose hostnames. For running outside Docker, use localhost.
DATABASE_URL=postgresql+asyncpg://trip:trip@postgres:5432/trip
REDIS_URL=redis://redis:6379/0

# Guardrails per run
MAX_TURNS=12
MAX_OUTPUT_TOKENS=4096
RUN_TOKEN_BUDGET=150000
RUN_TIMEOUT_SECONDS=300
WORKER_MAX_JOBS=10

# USD per million tokens. Copy these from the official pricing page for your model.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

CORS_ORIGINS=http://localhost:5173
